{
  "name": "savings-dashboard",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "astro:check": "astro check",
    "build": "prisma generate && astro check && astro build",
    "change-password": "node --experimental-strip-types --env-file=.env scripts/change-password.ts",
    "create-user": "node --experimental-strip-types --env-file=.env scripts/create-user.ts",
    "dev": "node --env-file=.env ./node_modules/astro/bin/astro.mjs dev",
    "dev:e2e": "node --env-file=.env.e2e ./node_modules/astro/bin/astro.mjs dev",
    "dev:host": "node --env-file=.env ./node_modules/astro/bin/astro.mjs dev --host",
    "dev:deps": "docker compose -f docker-compose.dev.yml up -d",
    "dev:deps:stop": "docker compose -f docker-compose.dev.yml stop",
    "dev:migrate": "prisma migrate dev",
    "dev:reset": "prisma migrate reset",
    "format": "prettier --write e2e prisma public scripts src",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "migrate": "prisma migrate deploy",
    "migrate:baseline": "sh scripts/migrate-with-baseline.sh",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "setup": "prisma generate && prisma migrate dev && prisma db seed",
    "start": "node ./dist/server/entry.mjs",
    "test": "vitest",
    "test:e2e": "pnpm run test:e2e:setup && pnpm run test:e2e:run && pnpm run test:e2e:teardown",
    "test:e2e:report": "playwright show-report",
    "test:e2e:run": "node --env-file=.env.e2e ./node_modules/@playwright/test/cli.js test",
    "test:e2e:setup": "docker compose -f docker-compose.e2e.yml up -d && sh -c 'for i in {1..30}; do if node --env-file=.env.e2e ./node_modules/prisma/build/index.js db push --accept-data-loss 2>/dev/null; then node --env-file=.env.e2e ./node_modules/prisma/build/index.js generate; break; fi; echo \"Waiting for PostgreSQL ($i/30)...\"; sleep 2; done' && node --env-file=.env.e2e ./node_modules/prisma/build/index.js db seed",
    "test:e2e:teardown": "docker compose -f docker-compose.e2e.yml down -v",
    "typecheck": "astro sync && tsc -b",
    "validate": "pnpm run test -- --run && pnpm run lint && pnpm run astro:check && pnpm run typecheck && pnpm run test:e2e"
  },
  "prettier": {
    "trailingComma": "es5",
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.2",
    "@astrojs/react": "^6.0.2",
    "@node-rs/bcrypt": "^1.10.8",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "dotenv": "^17.4.2",
    "iron-session": "^8.0.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "c8": "^12.0.0",
    "cross-env": "^10.1.0",
    "@eslint/compat": "^2.1.0",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.7.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.0.3",
  "version": "1.0.0"
}
