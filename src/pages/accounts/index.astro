---
import Layout from "~/layouts/Layout.astro";
import AccountsList from "~/components/AccountsList";
import { requireUserId } from "~/lib/session.server";
import { getAccounts } from "~/models/accounts.server";

const userId = await requireUserId(Astro.cookies);
const [activeAccounts, archivedAccounts] = await Promise.all([
  getAccounts({ userId, archived: false }),
  getAccounts({ userId, archived: true }),
]);
---

<Layout title="Accounts">
  <AccountsList
    activeAccounts={activeAccounts}
    archivedAccounts={archivedAccounts}
    client:load
  />
</Layout>
